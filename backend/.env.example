# ================= NFT Trader userbot + API sozlamalari =================
# Nusxa oling: cp backend/.env.example backend/.env  va to'ldiring.
# !!! .env HECH QACHON gitga kirmasin (repo'da .gitignore'da) !!!

# --- Telegram userbot (my.telegram.org/apps dan) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION=robo-trader
# Signal kanallari: @username yoki -1001234567890 (vergnul bilan)
SIGNAL_CHANNELS=

# --- Strategiya ---
ALLOWED_COLLECTIONS=Fantonverse,TON Diamonds,TON Punks,Notcoin Names
MAX_BUY_TON=45
MIN_PROFIT_PCT=5
MAX_OPEN_POSITIONS=10
MIN_HOLD_HOURS=1
MARKETPLACES_ENABLED=getgems,fragment,ton_diamonds
WALLET_BALANCE_TON=150

# --- Rejim: signal | paper | live ---
BOT_MODE=paper
SCANNER_ENABLED=1
SCAN_INTERVAL_SEC=120
FLOOR_PROVIDER=sim        # sim (API'siz test) yoki getgems (real so'rov)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8765
# Userbot POST /api/ingest/* yozishlari uchun tasodifiy uzun token:
INGEST_TOKEN=change-me-to-random-string
